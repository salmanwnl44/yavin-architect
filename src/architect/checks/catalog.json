      "severity": "major",
      "applies_to": { "element_kinds": ["flow"] },
      "implementation": { "kind": "builtin", "ref": "architect.checks.c012" },
      "version": 1,
      "changelog": [{ "version": 1, "date": "2026-10-03", "change": "initial" }]
    },
    {
      "id": "C-013",
      "title": "Referential integrity",
      "layer": "L0",
      "severity": "critical",
      "applies_to": { "element_kinds": ["model"] },
      "implementation": { "kind": "builtin", "ref": "architect.checks.c013" },
      "version": 1,
      "changelog": [{ "version": 1, "date": "2026-10-03", "change": "initial" }]
    }
  ]
